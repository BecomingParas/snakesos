# ===================================================================
# SNAKE RESCUE - PRODUCTION ENVIRONMENT VARIABLES
# ===================================================================
# ⚠️ NEVER COMMIT THIS FILE WITH REAL VALUES TO GIT!
# ⚠️ SET THESE IN VERCEL DASHBOARD → ENVIRONMENT VARIABLES
# ===================================================================

# ===================================================================
# NEON POSTGRESQL (PRODUCTION DATABASE)
# ===================================================================
# Get these from Neon Dashboard → Your Project → Connection Details

# Pooled connection (for Prisma in application)
DATABASE_URL="postgresql://user:password@ep-xxx-pooler.us-east-2.aws.neon.tech/snake_rescue?sslmode=require"

# Direct connection (for migrations only)
DIRECT_URL="postgresql://user:password@ep-xxx.us-east-2.aws.neon.tech/snake_rescue?sslmode=require"

# ===================================================================
# AUTHENTICATION & SECURITY
# ===================================================================

# Better Auth Base URL (your Vercel deployment URL)
BETTER_AUTH_URL=https://your-app.vercel.app/api/auth

# CSRF Secret (generate with: openssl rand -base64 32)
CSRF_SECRET=<generate-random-secret-32-chars>

# JWT Secret (generate with: openssl rand -base64 32)
JWT_SECRET=<generate-random-secret-32-chars>

# Cookie Domain (leave empty for Vercel subdomain, or set to your custom domain)
COOKIE_DOMAIN=

# CORS Origins (your frontend URL)
CORS_ORIGINS=https://your-app.vercel.app

# ===================================================================
# OAUTH (OPTIONAL)
# ===================================================================
# Only fill these if you want Google OAuth login
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ===================================================================
# EMAIL (BREVO SMTP)
# ===================================================================
# Copy these from your development .env
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=your-brevo-smtp-user
SMTP_PASSWORD=your-brevo-smtp-password
SMTP_FROM_EMAIL=your-verified-sender@example.com
SMTP_FROM_NAME=SnakeSOS Platform

# ===================================================================
# STRIPE (PAYMENTS)
# ===================================================================
# ⚠️ USE LIVE KEYS FOR PRODUCTION (not test keys!)
# Get from: https://dashboard.stripe.com/apikeys

STRIPE_SECRET_KEY=sk_live_your_live_secret_key_here
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret_here
STRIPE_SUCCESS_URL=https://your-app.vercel.app/payment/success
STRIPE_CANCEL_URL=https://your-app.vercel.app/payment/cancelled
PAYMENT_ACTIVE_PROVIDER=STRIPE
PAYMENT_DEMO_MODE=false

# ===================================================================
# CLOUDINARY (MEDIA STORAGE)
# ===================================================================
# Copy these from your development .env
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# ===================================================================
# PYTHON ML SNAKE CLASSIFIER (PRIMARY - RECOMMENDED)
# ===================================================================
# Your dedicated Python FastAPI snake classification model (GPU-accelerated)
# Get your model URL from Google Colab or your GPU server deployment
# This takes priority over OpenRouter/Google Cloud Vision when configured

# For Colab + Cloudflare Tunnel (Development/Demo)
PYTHON_ML_SERVICE_URL=https://investing-galaxy-connection-practitioner.trycloudflare.com
PYTHON_ML_API_KEY=G_PZBKORR35hxXMI4bFY6s0P8ktIEOHSyYlhprCYU_I
PYTHON_ML_TIMEOUT=30000

# For Production (replace with your permanent GPU server URL)
# PYTHON_ML_SERVICE_URL=https://your-gpu-server.com
# PYTHON_ML_API_KEY=your-production-api-key
# PYTHON_ML_TIMEOUT=30000

# ===================================================================
# OPENROUTER AI (FALLBACK - OPTIONAL)
# ===================================================================
# Only needed if you want to use OpenRouter as fallback
OPENROUTER_API_KEY=your-openrouter-api-key
OPENROUTER_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free

# ===================================================================
# UPSTASH REDIS (OPTIONAL - FOR BACKGROUND JOBS)
# ===================================================================
# Only needed if you implement background jobs
# Get from: https://console.upstash.com
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ===================================================================
# FRONTEND VARIABLES (NEXT_PUBLIC_*)
# ===================================================================
# ⚠️ These are exposed to the browser - NEVER put secrets here!

# Application URL (your Vercel deployment URL)
NEXT_PUBLIC_APP_URL=https://your-app.vercel.app

# GraphQL API URL (same domain, no CORS issues)
NEXT_PUBLIC_GRAPHQL_URL=https://your-app.vercel.app/api/graphql

# Better Auth URL (same domain)
NEXT_PUBLIC_AUTH_URL=https://your-app.vercel.app/api/auth

# Google Maps API Key (MUST be restricted in Google Cloud Console)
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=your-google-maps-api-key

# ===================================================================
# APPLICATION METADATA
# ===================================================================
NODE_ENV=production
APP_NAME=SnakeSOS
SUPPORT_EMAIL=support@snakesos.org

# ===================================================================
# VERCEL DEPLOYMENT NOTES
# ===================================================================
# 
# How to set these in Vercel:
# 1. Go to your project in Vercel Dashboard
# 2. Click "Settings" → "Environment Variables"
# 3. Add each variable above
# 4. Set "Environments" to: Production, Preview, Development (or as needed)
# 5. Click "Save"
# 6. Redeploy your application
#
# Security Checklist:
# ✓ DATABASE_URL uses pooled connection (has "-pooler" in hostname)
# ✓ DIRECT_URL uses direct connection (no "-pooler")
# ✓ JWT_SECRET and CSRF_SECRET are random 32+ character strings
# ✓ STRIPE_SECRET_KEY starts with sk_live_ (not sk_test_)
# ✓ STRIPE_WEBHOOK_SECRET configured after first deployment
# ✓ Google Maps API key restricted by HTTP referrer
# ✓ CLOUDINARY_API_SECRET is set (never exposed to frontend)
# ✓ All NEXT_PUBLIC_* URLs point to production domain
#
# ===================================================================
