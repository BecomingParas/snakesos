# ===================================================================
# PRODUCTION ENVIRONMENT VARIABLES FOR VERCEL FRONTEND
# ===================================================================
# 
# Add these to Vercel Dashboard → Project Settings → Environment Variables
# 
# IMPORTANT: 
# - Only NEXT_PUBLIC_* variables are exposed to the browser
# - Never put backend secrets (DATABASE_URL, JWT_SECRET, etc.) here
# - These are for the FRONTEND deployment only
# ===================================================================

# ===================================================================
# BACKEND API ENDPOINTS (REQUIRED)
# ===================================================================
# Replace with your actual production backend URL
NEXT_PUBLIC_API_URL=https://api.snakesos.com
NEXT_PUBLIC_GRAPHQL_URL=https://api.snakesos.com/graphql
NEXT_PUBLIC_AUTH_URL=https://api.snakesos.com/api/auth

# ===================================================================
# FRONTEND URL (REQUIRED)
# ===================================================================
# This will be your Vercel deployment URL
# Update this after deploying or when using custom domain
NEXT_PUBLIC_FRONTEND_URL=https://snakesos.vercel.app
NEXT_PUBLIC_APP_URL=https://snakesos.vercel.app

# ===================================================================
# ENVIRONMENT (AUTO-SET BY VERCEL)
# ===================================================================
NODE_ENV=production

# ===================================================================
# OPTIONAL: EXTERNAL SERVICES
# ===================================================================
# Only add if your frontend uses these directly
# NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=your_key_here

# ===================================================================
# STRIPE PUBLISHABLE KEY (SAFE FOR FRONTEND)
# ===================================================================
# Only the publishable key (pk_live_...) - NEVER the secret key
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_your_publishable_key_here

# ===================================================================
# NOTES:
# ===================================================================
# 1. Your backend should be deployed separately (AWS/Railway/Render)
# 2. Make sure backend CORS allows your Vercel domain
# 3. For Better Auth, configure cookies for cross-origin if needed
# 4. Test all API connections after deployment
# 5. Monitor Vercel build logs for any missing variables
