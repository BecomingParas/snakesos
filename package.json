{
  "name": "@snake-rescue/source",
  "version": "0.0.0",
  "license": "MIT",
  "scripts": {
    "dev:frontend": "nx serve frontend",
    "dev:backend": "cross-env HOST=127.0.0.1 node --watch --conditions=@snake-rescue/source --import @swc-node/register/esm-register apps/backend/src/main.ts",
    "dev": "concurrently \"npm run dev:frontend\" \"npm run dev:backend\"",
    "build:frontend": "npx nx build frontend",
    "build:backend": "npx nx build backend",
    "build:shared": "npx nx build shared",
    "build:all": "npm run build:shared && npm run build:frontend && npm run build:backend",
    "build": "npx nx build --all",
    "db:generate": "prisma generate --config libs/database/prisma.config.ts && node scripts/ensure-prisma-esm.mjs",
    "db:migrate": "prisma migrate dev --config libs/database/prisma.config.ts",
    "db:push": "prisma db push --config libs/database/prisma.config.ts",
    "db:studio": "prisma studio --config libs/database/prisma.config.ts",
    "db:seed": "cross-env DATABASE_URL=\"postgresql://devuser:devpassword@localhost:5433/snake_rescue?schema=public\" tsx libs/database/prisma/seed.ts",
    "db:seed:full": "cross-env DATABASE_URL=\"postgresql://devuser:devpassword@localhost:5433/snake_rescue?schema=public\" tsx libs/database/prisma/seed-full.ts",
    "seed:payment-demo": "dotenv -e .env -- tsx scripts/seed-payment-demo-10.ts",
    "seed:demo-workflow": "tsx scripts/seed-demo-workflow.ts",
    "graphql:codegen": "yarn workspace @snake-rescue/contracts codegen",
    "graphql:codegen:watch": "yarn workspace @snake-rescue/contracts codegen:watch",
    "graphql:generate": "yarn graphql:codegen",
    "verify:vercel": "node scripts/verify-vercel-deployment.mjs",
    "prepare": "node -e \"try { require('husky') } catch (e) { if (e.code !== 'MODULE_NOT_FOUND') throw e }\"",
    "lint": "nx affected --target=lint",
    "format": "nx format:write"
  },
