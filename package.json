    "@graphql-codegen/typescript-react-apollo": "^4.4.2",
    "@graphql-codegen/typescript-resolvers": "^6.1.0",
    "@next/eslint-plugin-next": "^16.1.6",
    "@nx/cypress": "23.1.0",
    "@nx/esbuild": "^23.1.0",
    "@nx/eslint": "23.1.0",
    "@nx/eslint-plugin": "23.1.0",
    "@nx/jest": "23.1.0",
    "@nx/js": "^23.1.0",
    "@nx/next": "^23.1.0",
    "@nx/node": "^23.1.0",
    "@nx/react": "^23.1.0",
    "@swc-node/register": "~1.11.1",
