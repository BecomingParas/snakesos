// ===================================================================
// BUTWAL SNAKE RESCUE PLATFORM - PRISMA SCHEMA
// ===================================================================
// Production-grade PostgreSQL database schema for enterprise snake
// rescue management, volunteer coordination, AI identification,
// CMS, and donation system.
//
// Reference: https://www.butwalsnake.com/
// ===================================================================

generator client {
  provider      = "prisma-client"
  output        = "../src/prisma/generated"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
}

// ===================================================================
// USER MANAGEMENT & AUTHENTICATION
// ===================================================================

model User {
  id       String     @id @default(uuid())
  email    String     @unique
  password String? // Null for OAuth users
  name     String
  phone    String?
  role     UserRole   @default(CITIZEN)
  status   UserStatus @default(ACTIVE)
  avatar   String?

  // OAuth Integration
  googleId    String? @unique
  googleEmail String?

  // Email Verification
  emailVerified Boolean   @default(false)
  verifiedAt    DateTime?

  // Security
  lastLoginAt         DateTime?
  lastLoginIp         String?
  passwordResetToken  String?
  passwordResetExpiry DateTime?

  // Preferences
  language                String @default("en")
  timezone                String @default("Asia/Kathmandu")
  notificationPreferences Json? // Notification preferences

  // Metadata
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime? // Soft delete

  // Relations
  rescueRequests              RescueRequest[]
  volunteerProfile            Volunteer?
  blogPosts                   BlogPost[]
  galleryImages               GalleryImage[]
  donations                   Donation[]
  aiIdentifications           AIIdentification[]
  notifications               Notification[]
  activityLogs                ActivityLog[]
  financialAuditEvents        FinancialAuditEvent[]
  createdCompensationPolicies CompensationPolicy[]
  createdRefunds              Refund[]
  rescueTimelines             RescueTimeline[]
  trainings                   Training[]
  speciesObservations         SpeciesObservation[]  @relation
  citizenRescueRatings        RescueRating[]        @relation("CitizenRatings")
  emergencyContact            EmergencyContact?

  // Better Auth Relations
  sessions    Session[]
  accounts    Account[]
  mediaAssets MediaAsset[]

  // RBAC Relations
  userRoles UserRoleAssignment[]

  @@index([email])
  @@index([role])
  @@index([status])
  @@index([googleId])
  @@map("users")
}

enum UserRole {
  CITIZEN
  VOLUNTEER
  VERIFIED_RESCUER
  DISTRICT_COORDINATOR
  ADMIN
  SUPER_ADMIN
}

model EmergencyContact {
  id           String   @id @default(uuid())
  userId       String   @unique
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name         String
  phone        String
  relationship String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
  PENDING_VERIFICATION
  BANNED
}

enum MediaProvider {
  CLOUDINARY
}

enum MediaStatus {
  PENDING
  UPLOADED
  VERIFIED
  REJECTED
  DELETED
}

enum MediaType {
  RESCUER_PROFILE_IMAGE
  CITIZEN_PROFILE_IMAGE
  ADMIN_PROFILE_IMAGE
  RESCUER_VERIFICATION_DOCUMENT
}

model MediaAsset {
  id               String        @id @default(cuid())
  ownerId          String
  mediaType        MediaType
  provider         MediaProvider @default(CLOUDINARY)
  publicId         String        @unique
  resourceType     String        @default("image")
  originalFileName String?
  mimeType         String
  sizeBytes        BigInt?
  width            Int?
  height           Int?
  format           String?
  status           MediaStatus   @default(PENDING)
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  owner            User          @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  @@index([ownerId])
  @@index([mediaType])
  @@index([status])
  @@map("media_assets")
}

// ===================================================================
// BETTER AUTH TABLES (Authentication)
// ===================================================================

model Session {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String   @unique
  expiresAt DateTime
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([token])
  @@map("sessions")
}

model Account {
  id           String    @id @default(uuid())
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  providerId   String    @map("provider") // "credential", "google", "github", etc.
  accountId    String    @map("providerAccountId") // Provider-specific account ID
  accessToken  String?   @db.Text
  refreshToken String?   @db.Text
  expiresAt    DateTime?
  tokenType    String?
  scope        String?
  idToken      String?   @db.Text
  password     String? // Hashed password for credential accounts (Better Auth requirement)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@unique([providerId, accountId])
  @@index([userId])
  @@map("accounts")
}

model Verification {
  id         String   @id @default(uuid())
  identifier String // email or phone
  token      String   @unique
  code       String? // 6-digit verification code
  type       String // "email", "password-reset"
  expiresAt  DateTime
  createdAt  DateTime @default(now())

  @@index([token])
  @@index([identifier])
  @@index([code])
  @@map("verifications")
}

// ===================================================================
// RBAC TABLES (Authorization)
// ===================================================================

model Role {
  id          String   @id @default(uuid())
  name        String   @unique // "ADMIN", "VOLUNTEER", etc.
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  permissions RolePermission[]
  userRoles   UserRoleAssignment[]

  @@map("roles")
}

model Permission {
  id          String   @id @default(uuid())
  name        String   @unique // "MANAGE_USERS", "ASSIGN_RESCUES", etc.
  description String?
  resource    String // "users", "rescues", "volunteers"
  action      String // "create", "read", "update", "delete"
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  roles RolePermission[]

  @@unique([resource, action])
  @@map("permissions")
}

model RolePermission {
  roleId       String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permissionId String
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model UserRoleAssignment {
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  roleId    String
  role      Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)
  grantedAt DateTime @default(now())
  grantedBy String?

  @@id([userId, roleId])
  @@map("user_role_assignments")
}

// ===================================================================
// RESCUE MANAGEMENT
// ===================================================================

model RescueRequest {
  id String @id @default(uuid())

  // Reporter Information
  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)
  name   String
  phone  String
  email  String?

  // Location Details
  municipality     String
  ward             Int?
  address          String
  landmark         String?
  lat              Float?
  lng              Float?
  locationAccuracy Float? // GPS accuracy in meters

  // Snake Information
  snakeDescription String?
  snakeSize        String? // "Small (<1ft)", "Medium (1-3ft)", "Large (>3ft)"
  snakeColor       String?
  snakeImageUrl    String?
  snakeImages      String[] // Multiple images

  // Species Identification
  speciesId          String?
  species            SnakeSpecies?     @relation(fields: [speciesId], references: [id], onDelete: SetNull)
  aiIdentificationId String?           @unique
  aiIdentification   AIIdentification? @relation(fields: [aiIdentificationId], references: [id])

  // Rescue Status
  status        RescueStatus   @default(PENDING)
  priority      RescuePriority @default(MEDIUM)
  stillPresent  Boolean        @default(true)
  notes         String?        @db.Text
  internalNotes String?        @db.Text // Admin-only notes

  // Assignment
  assignedTo        String?
  assignedVolunteer Volunteer? @relation(fields: [assignedTo], references: [id], onDelete: SetNull)
  assignedAt        DateTime?
  assignedBy        String? // Admin who assigned

  // Tracking
  acceptedAt DateTime?
  arrivedAt  DateTime?
  startedAt  DateTime?

  // Completion
  completedAt    DateTime?
  outcome        RescueOutcome?
  rescueReport   String?        @db.Text
  rescueImages   String[]
  rescueDuration Int? // Minutes

  // Verification
  verifiedBy String?
  verifiedAt DateTime?

  // Emergency Details
  isEmergency      Boolean @default(false)
  emergencyDetails String?
  hasBite          Boolean @default(false)
  biteDetails      String?

  // Metadata
  source          String    @default("WEB") // WEB, APP, PHONE, TELEGRAM
  referenceNumber String?   @unique // Human-readable ref like "BR-2024-001"
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  deletedAt       DateTime?

  // Geospatial Intelligence Enhancements
  estimatedTravelTimeMinutes Int? // Estimated travel time to location
  routeDistance              Float? // km from rescuer to incident
  routeGeometry              Json? // GeoJSON of route taken
  nearestHospitalId          String?
  nearestHospital            Hospital? @relation("NearestHospital", fields: [nearestHospitalId], references: [id])

  // Vehicle assignment
  vehicleId String?
  vehicle   RescueVehicle? @relation("VehicleRescues", fields: [vehicleId], references: [id])

  // Hospital visit after rescue (for analytics)
  victimWentToHospital  Boolean?
  hospitalId            String?
  hospitalVisit         Hospital? @relation("RescueHospitalVisits", fields: [hospitalId], references: [id])
  antivenomAdministered Boolean?
  antivenomType         String?
  hospitalAdmission     Boolean?
  hospitalNotes         String?   @db.Text

  // Relations
  timeline      RescueTimeline[]
  notifications Notification[]
  rescueCharge  RescueCharge?
  rating        RescueRating?

  @@index([status])
  @@index([priority])
  @@index([municipality])
  @@index([assignedTo])
  @@index([createdAt])
  @@index([userId])
  @@index([speciesId])
  @@map("rescue_requests")
}

enum RescueStatus {
  PENDING // New request, not assigned
  ASSIGNED // Assigned to volunteer
  ACCEPTED // Volunteer accepted
  IN_PROGRESS // Volunteer en route or on site
  COMPLETED // Successfully rescued
  CANCELLED // Cancelled by reporter
  CLOSED // Closed without rescue
  EXPIRED // No response within time limit
}

enum RescuePriority {
  LOW // Non-venomous, not urgent
  MEDIUM // Standard rescue
  HIGH // Venomous snake
  CRITICAL // Bite victim, immediate danger
}

enum RescueOutcome {
  RESCUED_RELOCATED // Snake rescued and relocated
  ALREADY_GONE // Snake left before arrival
  FALSE_ALARM // Not a snake or no danger
  NO_SNAKE_FOUND // Could not locate
  DECEASED // Snake was dead
  REFUSED_HELP // Reporter changed mind
}

model RescueTimeline {
  id       String        @id @default(uuid())
  rescueId String
  rescue   RescueRequest @relation(fields: [rescueId], references: [id], onDelete: Cascade)

  event       String // "CREATED", "ASSIGNED", "ACCEPTED", "COMPLETED"
  description String? @db.Text
  metadata    Json? // Additional context

  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  lat Float? // Location when event occurred
  lng Float?

  createdAt DateTime @default(now())

  @@index([rescueId])
  @@index([createdAt])
  @@map("rescue_timelines")
}

// ===================================================================
// VOLUNTEER MANAGEMENT
// ===================================================================

model Volunteer {
  id String @id @default(uuid())

  // User Link
  userId String? @unique
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  // Personal Information
  name         String
  contact      String
  email        String?
  address      String
  municipality String
  ward         Int?
  dateOfBirth  DateTime?
  gender       String?

  // Emergency Contact
  emergencyContact String?
  emergencyPhone   String?

  // Qualification & Experience
  experience      String // "Beginner", "Intermediate", "Expert"
  experienceYears Int?
  vehicle         String // "None", "Bike", "Car", "Both"
  vehicleDetails  String?
  skills          String[] // ["First Aid", "Snake Handling", "Photography"]
  certifications  String[]
  languages       String[] @default(["Nepali", "English"])

  // Availability
  availableTime         String // "Anytime", "Weekends", "Evenings"
  availableDays         String[] // ["Monday", "Tuesday", ...]
  availabilitySchedule  Json     @default("[]")
  emergencyAvailability Boolean  @default(true)
  isAvailableNow        Boolean  @default(false)
  assignedZone          String?
  coverageRadius        Int?     @default(5) // Kilometers

  // Location (for dispatch)
  currentLat         Float?
  currentLng         Float?
  lastLocationUpdate DateTime?

  // Profile
  imageUrl String?
  bio      String? @db.Text

  // Verification & Status
  status          VolunteerStatus @default(PENDING)
  verifiedAt      DateTime?
  verifiedBy      String?
  rejectedAt      DateTime?
  rejectedBy      String?
  rejectionReason String?

  // Performance Metrics
  totalRescues        Int    @default(0)
  completedRescues    Int    @default(0)
  cancelledRescues    Int    @default(0)
  successRate         Float?
  averageResponseTime Int? // Minutes
  averageRescueTime   Int? // Minutes
  rating              Float?
  totalRatings        Int    @default(0)

  // Training & Certification
  trainingCompleted   Boolean   @default(false)
  trainingDate        DateTime?
  certificationExpiry DateTime?

  // Equipment
  hasEquipment Boolean  @default(false)
  equipment    String[] // ["Snake Hook", "Tongs", "Bag", "Boots"]

  // Geospatial Intelligence Enhancements
  serviceRadiusKm                Float?    @default(20) // Service coverage radius
  serviceDistricts               Json? // Array of districts they serve
  totalResponseTimeMinutes       Int?      @default(0)
  averageResponseTimeMinutes     Float?
  lastKnownLatitude              Float? // Real-time location
  lastKnownLongitude             Float?
  lastLocationUpdateFromTracking DateTime? // Last location update timestamp

  // Vehicle assignment
  vehicleId       String?
  assignedVehicle RescueVehicle? @relation("VehicleRescuers", fields: [vehicleId], references: [id])

  // Metadata
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  // Relations
  rescueAssignments RescueRequest[]
  trainings         Training[]
  rescueCharges     RescueCharge[]
  settlements       Settlement[]
  ratings           RescueRating[]

  @@index([status])
  @@index([municipality])
  @@index([isAvailableNow])
  @@index([userId])
  @@map("volunteers")
}

enum VolunteerStatus {
  PENDING // Application submitted
  APPROVED // Basic approval
  VERIFIED // Fully verified rescuer
  SUSPENDED // Temporarily suspended
  REJECTED // Application rejected
  INACTIVE // Inactive/retired
}

model RescueRating {
  id              String   @id @default(uuid())
  rescueId        String   @unique
  citizenId       String
  rescuerId       String
  rating          Int
  feedback        String?  @db.Text
  responseSpeed   Int?
  professionalism Int?
  communication   Int?
  safetyHandling  Int?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  rescue  RescueRequest @relation(fields: [rescueId], references: [id], onDelete: Cascade)
  citizen User          @relation("CitizenRatings", fields: [citizenId], references: [id], onDelete: Cascade)
  rescuer Volunteer     @relation(fields: [rescuerId], references: [id], onDelete: Cascade)

  @@index([rescuerId])
  @@index([citizenId])
  @@index([createdAt])
  @@map("rescue_ratings")
}

model Training {
  id String @id @default(uuid())

  title       String
  description String? @db.Text
  type        String // "BASIC", "ADVANCED", "REFRESHER", "FIRST_AID"

  // Schedule
  scheduledAt DateTime
  duration    Int // Minutes
  location    String
  instructor  String?

  // Capacity
  maxParticipants Int @default(20)
  registeredCount Int @default(0)

  // Status
  status String @default("SCHEDULED") // SCHEDULED, ONGOING, COMPLETED, CANCELLED

  // Materials
  materials   String[] // URLs to training materials
  certificate String? // Certificate template

  // Metadata
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  participants User[]
  volunteers   Volunteer[]

  @@index([scheduledAt])
  @@index([status])
  @@map("trainings")
}

// ===================================================================
// SNAKE SPECIES DATABASE
// ===================================================================

model SnakeSpecies {
  id String @id @default(uuid())

  // Nomenclature
  name           String   @unique // English common name
  scientificName String   @unique
  nepaliName     String
  localNames     String[] // Regional names
  aliases        String[] // Alternative names

  // Classification
  family  String?
  genus   String?
  species String?

  // Danger Assessment
  venomous    Boolean      @default(false)
  dangerLevel DangerLevel?
  venomType   String? // "Neurotoxic", "Hemotoxic", "Cytotoxic"

  // Physical Characteristics
  averageLength       String? // "60-90 cm"
  maxLength           String?
  color               String?
  pattern             String?
  identificationGuide String?  @db.Text
  distinctiveFeatures String[]

  // Behavior & Habitat
  behavior   String? @db.Text
  habitat    String? @db.Text
  activeTime String? // "Nocturnal", "Diurnal", "Both"
  diet       String?

  // Safety Information
  safetyTips      String?  @db.Text
  emergencyAdvice String?  @db.Text
  firstAidSteps   String[]

  // Distribution
  foundInNepal  Boolean  @default(true)
  regions       String[] // Districts/regions
  altitudeRange String? // "0-1000m"

  // Conservation
  conservationStatus String? // "Least Concern", "Endangered", etc.
  protected          Boolean @default(false)

  // Media
  imageUrl String?
  images   String[]
  videoUrl String?

  // Statistics
  rescueCount         Int @default(0)
  identificationCount Int @default(0)

  // Metadata
  verified   Boolean   @default(false)
  verifiedBy String?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  deletedAt  DateTime?

  // Relations
  rescueRequests    RescueRequest[]
  aiIdentifications AIIdentification[]
  historicalCases   SnakebiteCase[]      @relation
  observations      SpeciesObservation[] @relation

  @@index([venomous])
  @@index([dangerLevel])
  @@index([family])
  @@map("snake_species")
}

enum DangerLevel {
  HARMLESS // No venom, no danger
  MILDLY_VENOMOUS // Mild symptoms
  MEDICALLY_SIGNIFICANT // Requires medical attention
  HIGHLY_DANGEROUS // Can be fatal
}

// ===================================================================
// AI SNAKE IDENTIFICATION
// ===================================================================

model AIIdentification {
  id String @id @default(uuid())

  // Input
  imageUrl       String
  imageThumbnail String?
  uploadSource   String  @default("WEB") // WEB, APP, API

  // Results
  speciesId  String?
  species    SnakeSpecies? @relation(fields: [speciesId], references: [id], onDelete: SetNull)
  confidence Float // 0.0 to 1.0

  // Alternative Matches
  alternativeMatches Json? // [{ speciesId, confidence, name }]

  // AI Provider Details
  provider     String // "gemini", "openai", "claude", "local"
  model        String // "gemini-1.5-pro", "gpt-4-vision", etc.
  promptUsed   String? @db.Text
  responseTime Int? // Milliseconds

  // Additional Analysis
  venomousDetected Boolean?
  dangerAssessment String?
  colorDetected    String[]
  sizeEstimate     String?

  // User Context
  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  // Feedback
  userFeedback     String? // "CORRECT", "INCORRECT", "PARTIAL"
  correctSpeciesId String? // If user corrects identification

  // Metadata
  createdAt DateTime @default(now())

  // Relations
  rescueRequest RescueRequest?

  @@index([speciesId])
  @@index([userId])
  @@index([provider])
  @@index([createdAt])
  @@map("ai_identifications")
}

// ===================================================================
// CONTENT MANAGEMENT SYSTEM (CMS)
// ===================================================================

model BlogPost {
  id String @id @default(uuid())

  // Content
  title   String
  slug    String  @unique
  content String  @db.Text
  excerpt String? @db.Text

  // Categorization
  category String   @default("News") // News, Education, Research, Success Story
  tags     String[]

  // Author
  authorId String
  author   User   @relation(fields: [authorId], references: [id], onDelete: Cascade)

  // Publishing
  status      PostStatus @default(DRAFT)
  publishedAt DateTime?
  scheduledAt DateTime? // For scheduled publishing

  // Media
  imageUrl String? // Featured image
  images   String[] // Content images
  videoUrl String?

  // SEO
  metaTitle       String?
  metaDescription String?
  metaKeywords    String[]

  // Engagement
  views  Int @default(0)
  likes  Int @default(0)
  shares Int @default(0)

  // Comments (future feature)
  commentsEnabled Boolean @default(true)
  commentCount    Int     @default(0)

  // Metadata
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([status])
  @@index([category])
  @@index([authorId])
  @@index([publishedAt])
  @@index([slug])
  @@map("blog_posts")
}

enum PostStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
  SCHEDULED
}

model GalleryImage {
  id String @id @default(uuid())

  // Content
  title        String?
  description  String? @db.Text
  imageUrl     String
  thumbnailUrl String?

  // Categorization
  category String? // "Rescue", "Species", "Training", "Event"
  tags     String[]

  // Context
  rescueId  String? // Link to rescue if applicable
  speciesId String? // Link to species if applicable

  // Uploader
  uploadedBy String?
  uploader   User?   @relation(fields: [uploadedBy], references: [id], onDelete: SetNull)

  // Visibility
  isPublic   Boolean @default(true)
  isFeatured Boolean @default(false)

  // Engagement
  views Int @default(0)
  likes Int @default(0)

  // Metadata
  fileSize   Int? // Bytes
  dimensions String? // "1920x1080"
  format     String? // "jpeg", "png"

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([category])
  @@index([uploadedBy])
  @@index([isPublic])
  @@index([isFeatured])
  @@map("gallery_images")
}

// ===================================================================
// DONATIONS & PAYMENTS
// ===================================================================

model Donation {
  id String @id @default(uuid())

  // Donor Information
  donorId    String?
  donor      User?   @relation(fields: [donorId], references: [id], onDelete: SetNull)
  donorName  String
  donorEmail String?
  donorPhone String?

  // Amount
  amount    Float
  currency  String @default("NPR")
  amountUSD Float? // Converted amount for reporting

  // Payment Details
  paymentMethod   PaymentMethod
  paymentGateway  String // "esewa", "khalti", "stripe", "bank"
  transactionId   String?       @unique
  gatewayResponse Json? // Full gateway response

  // Status
  status PaymentStatus @default(PENDING)
  paidAt DateTime?

  // Purpose
  purpose   String? // "General", "Emergency Fund", "Equipment", "Training"
  campaign  String? // Specific campaign
  message   String? @db.Text
  anonymous Boolean @default(false)

  // Receipt
  receiptNumber String? @unique
  receiptUrl    String?
  invoiceUrl    String?

  // Verification
  verifiedAt        DateTime?
  verifiedBy        String?
  verificationNotes String?

  // Refund
  refundedAt   DateTime?
  refundReason String?
  refundAmount Float?

  // Metadata
  ipAddress String?
  userAgent String?
  source    String  @default("WEB") // WEB, APP, ADMIN

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  financialTransactions FinancialTransaction[]
  paymentIntents        PaymentIntent[]

  @@index([status])
  @@index([paymentMethod])
  @@index([donorId])
  @@index([createdAt])
  @@map("donations")
}

// ===================================================================
// FINANCE DOMAIN
// ===================================================================

model CompensationPolicy {
  id             String    @id @default(uuid())
  name           String
  currency       String    @default("NPR")
  grossAmount    Decimal   @db.Decimal(12, 2)
  fixedAmount    Decimal   @db.Decimal(12, 2)
  commissionRate Decimal   @db.Decimal(5, 2)
  effectiveFrom  DateTime
  effectiveTo    DateTime?
  isActive       Boolean   @default(true)
  createdById    String?
  createdBy      User?     @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  rescueCharges RescueCharge[]

  @@index([effectiveFrom, effectiveTo])
  @@index([isActive])
  @@map("compensation_policies")
}

model RescueCharge {
  id                       String                     @id @default(uuid())
  rescueId                 String                     @unique
  rescue                   RescueRequest              @relation(fields: [rescueId], references: [id], onDelete: Restrict)
  rescuerId                String?
  rescuer                  Volunteer?                 @relation(fields: [rescuerId], references: [id], onDelete: SetNull)
  policyId                 String?
  policy                   CompensationPolicy?        @relation(fields: [policyId], references: [id], onDelete: SetNull)
  currency                 String                     @default("NPR")
  grossAmount              Decimal                    @db.Decimal(12, 2)
  discountAmount           Decimal                    @default(0) @db.Decimal(12, 2)
  taxAmount                Decimal                    @default(0) @db.Decimal(12, 2)
  processingFee            Decimal                    @default(0) @db.Decimal(12, 2)
  platformCommissionRate   Decimal                    @db.Decimal(5, 2)
  platformCommissionAmount Decimal                    @db.Decimal(12, 2)
  rescuerAmount            Decimal                    @db.Decimal(12, 2)
  netAmount                Decimal                    @db.Decimal(12, 2)
  status                   FinancialTransactionStatus @default(PENDING)
  finalizedAt              DateTime?
  createdAt                DateTime                   @default(now())
  updatedAt                DateTime                   @updatedAt

  transaction   FinancialTransaction?
  settlement    Settlement?
  paymentIntent PaymentIntent?

  @@index([status])
  @@index([rescuerId])
  @@index([createdAt])
  @@map("rescue_charges")
}

model FinancialTransaction {
  id                       String                     @id @default(uuid())
  type                     FinancialTransactionType
  status                   FinancialTransactionStatus @default(PENDING)
  currency                 String                     @default("NPR")
  rescueChargeId           String?                    @unique
  rescueCharge             RescueCharge?              @relation(fields: [rescueChargeId], references: [id], onDelete: Restrict)
  donationId               String?
  donation                 Donation?                  @relation(fields: [donationId], references: [id], onDelete: Restrict)
  provider                 String?
  externalReference        String?
  idempotencyKey           String?                    @unique
  grossAmount              Decimal                    @db.Decimal(12, 2)
  discountAmount           Decimal                    @default(0) @db.Decimal(12, 2)
  taxAmount                Decimal                    @default(0) @db.Decimal(12, 2)
  processingFee            Decimal                    @default(0) @db.Decimal(12, 2)
  platformCommissionRate   Decimal?                   @db.Decimal(5, 2)
  platformCommissionAmount Decimal                    @default(0) @db.Decimal(12, 2)
  rescuerAmount            Decimal                    @default(0) @db.Decimal(12, 2)
  netAmount                Decimal                    @db.Decimal(12, 2)
  finalizedAt              DateTime?
  createdAt                DateTime                   @default(now())
  updatedAt                DateTime                   @updatedAt

  refunds       Refund[]
  ledgerEntries LedgerEntry[]
  settlement    Settlement?

  @@index([type, status])
  @@index([donationId])
  @@index([externalReference])
  @@index([createdAt])
  @@map("financial_transactions")
}

model PaymentIntent {
  id                String              @id @default(uuid())
  rescueChargeId    String?             @unique
  rescueCharge      RescueCharge?       @relation(fields: [rescueChargeId], references: [id], onDelete: Restrict)
  donationId        String?
  donation          Donation?           @relation(fields: [donationId], references: [id], onDelete: Restrict)
  provider          String
  amount            Decimal             @db.Decimal(12, 2)
  currency          String              @default("NPR")
  status            PaymentIntentStatus @default(CREATED)
  providerReference String?
  idempotencyKey    String              @unique
  metadata          Json?
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt

  @@index([donationId])
  @@index([provider, status])
  @@index([providerReference])
  @@map("payment_intents")
}

model Refund {
  id                String               @id @default(uuid())
  transactionId     String
  transaction       FinancialTransaction @relation(fields: [transactionId], references: [id], onDelete: Restrict)
  amount            Decimal              @db.Decimal(12, 2)
  currency          String               @default("NPR")
  reason            String?
  providerReference String?
  idempotencyKey    String?              @unique
  status            PaymentStatus        @default(PENDING)
  createdById       String?
  createdBy         User?                @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdAt         DateTime             @default(now())
  processedAt       DateTime?

  @@index([transactionId])
  @@index([status])
  @@map("refunds")
}

model Settlement {
  id             String               @id @default(uuid())
  transactionId  String               @unique
  transaction    FinancialTransaction @relation(fields: [transactionId], references: [id], onDelete: Restrict)
  rescueChargeId String?              @unique
  rescueCharge   RescueCharge?        @relation(fields: [rescueChargeId], references: [id], onDelete: Restrict)
  rescuerId      String
  rescuer        Volunteer            @relation(fields: [rescuerId], references: [id], onDelete: Restrict)
  amount         Decimal              @db.Decimal(12, 2)
  currency       String               @default("NPR")
  status         SettlementStatus     @default(PENDING)
  eligibleAt     DateTime?
  settledAt      DateTime?
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt

  payouts Payout[]

  @@index([rescuerId, status])
  @@index([status])
  @@map("settlements")
}

model Payout {
  id                String         @id @default(uuid())
  settlementId      String
  settlement        Settlement     @relation(fields: [settlementId], references: [id], onDelete: Restrict)
  rescuerId         String
  amount            Decimal        @db.Decimal(12, 2)
  currency          String         @default("NPR")
  status            PayoutStatus   @default(PENDING)
  paymentMethod     PaymentMethod?
  externalReference String?
  idempotencyKey    String         @unique
  requestedAt       DateTime       @default(now())
  processedAt       DateTime?
  failedAt          DateTime?
  failureReason     String?

  @@index([rescuerId, status])
  @@index([settlementId])
  @@map("payouts")
}

model LedgerEntry {
  id            String               @id @default(uuid())
  transactionId String
  transaction   FinancialTransaction @relation(fields: [transactionId], references: [id], onDelete: Restrict)
  account       String
  direction     LedgerDirection
  amount        Decimal              @db.Decimal(12, 2)
  currency      String               @default("NPR")
  description   String?
  createdAt     DateTime             @default(now())

  @@index([transactionId])
  @@index([account, createdAt])
  @@map("ledger_entries")
}

model FinancialAuditEvent {
  id            String   @id @default(uuid())
  actorId       String?
  actor         User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)
  action        String
  entityType    String
  entityId      String
  previousState Json?
  newState      Json?
  amount        Decimal? @db.Decimal(12, 2)
  currency      String?
  metadata      Json?
  createdAt     DateTime @default(now())

  @@index([entityType, entityId])
  @@index([actorId])
  @@index([action, createdAt])
  @@map("financial_audit_events")
}

enum FinancialTransactionType {
  RESCUE_CHARGE
  DONATION
}

enum FinancialTransactionStatus {
  PENDING
  AUTHORIZED
  PAID
  PARTIALLY_REFUNDED
  REFUNDED
  SETTLEMENT_PENDING
  SETTLED
  FAILED
  CANCELLED
}

enum PaymentIntentStatus {
  CREATED
  REQUIRES_ACTION
  AUTHORIZED
  SUCCEEDED
  FAILED
  CANCELLED
}

enum SettlementStatus {
  PENDING
  ELIGIBLE
  PROCESSING
  SETTLED
  FAILED
  CANCELLED
}

enum PayoutStatus {
  PENDING
  APPROVED
  PROCESSING
  PAID
  FAILED
  REJECTED
  CANCELLED
}

enum LedgerDirection {
  DEBIT
  CREDIT
}

enum PaymentMethod {
  ESEWA
  KHALTI
  IME_PAY
  FONEPAY
  BANK_TRANSFER
  STRIPE
  PAYPAL
  CASH
}

enum PaymentStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
  REFUNDED
  CANCELLED
}

// ===================================================================
// NOTIFICATIONS & MESSAGING
// ===================================================================

model Notification {
  id String @id @default(uuid())

  // Recipient
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Content
  type      NotificationType
  title     String
  message   String           @db.Text
  link      String?
  actionUrl String?

  // Delivery Channels
  sentViaApp      Boolean @default(true)
  sentViaEmail    Boolean @default(false)
  sentViaSMS      Boolean @default(false)
  sentViaTelegram Boolean @default(false)

  // Status
  read   Boolean   @default(false)
  readAt DateTime?

  // Context
  rescueId String?
  rescue   RescueRequest? @relation(fields: [rescueId], references: [id], onDelete: Cascade)

  // Metadata
  metadata  Json?
  priority  String    @default("NORMAL") // LOW, NORMAL, HIGH, URGENT
  expiresAt DateTime?

  createdAt DateTime @default(now())

  @@index([userId, read])
  @@index([type])
  @@index([createdAt])
  @@map("notifications")
}

enum NotificationType {
  RESCUE_CREATED
  RESCUE_ASSIGNED
  RESCUE_ACCEPTED
  RESCUE_COMPLETED
  RESCUE_CANCELLED
  VOLUNTEER_APPROVED
  VOLUNTEER_REJECTED
  TRAINING_SCHEDULED
  TRAINING_REMINDER
  DONATION_RECEIVED
  SYSTEM_ALERT
  ANNOUNCEMENT
}

// ===================================================================
// CONTACT & INQUIRIES
// ===================================================================

model ContactMessage {
  id String @id @default(uuid())

  // Sender
  name    String
  email   String
  phone   String?
  subject String
  message String  @db.Text

  // Classification
  category String @default("GENERAL") // GENERAL, RESCUE, VOLUNTEER, DONATION, TECHNICAL
  priority String @default("NORMAL")

  // Status
  status     String  @default("NEW") // NEW, READ, RESPONDED, CLOSED
  assignedTo String?

  // Response
  responded   Boolean   @default(false)
  respondedAt DateTime?
  response    String?   @db.Text

  // Metadata
  ipAddress String?
  userAgent String?
  source    String  @default("WEB")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([category])
  @@index([createdAt])
  @@map("contact_messages")
}

// ===================================================================
// AUDIT & ACTIVITY LOGS
// ===================================================================

model ActivityLog {
  id String @id @default(uuid())

  // Actor
  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  // Action
  action   String // "LOGIN", "LOGOUT", "CREATE_RESCUE", "UPDATE_STATUS", etc.
  entity   String? // "RescueRequest", "Volunteer", "User", etc.
  entityId String?

  // Details
  description String?
  metadata    Json? // Additional context

  // Changes (for audit trail)
  oldValues Json?
  newValues Json?

  // Request Context
  ipAddress String?
  userAgent String?
  method    String? // GET, POST, PUT, DELETE
  url       String?

  // Result
  success      Boolean @default(true)
  errorMessage String?

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([action])
  @@index([entity, entityId])
  @@index([createdAt])
  @@map("activity_logs")
}

// ===================================================================
// HOSPITAL & ANTIVENOM MANAGEMENT
// ===================================================================

model Hospital {
  id String @id @default(uuid())

  // Basic Information
  name         String
  address      String
  municipality String
  ward         Int?
  district     String
  province     String

  // Contact Information
  phone          String?
  email          String?
  emergencyPhone String?

  // Location (Required for mapping)
  latitude  Float
  longitude Float

  // Emergency Capabilities
  emergencyAvailable Boolean @default(false)
  emergency24x7      Boolean @default(false)

  // Snakebite Treatment Capability
  snakebiteTreatmentAvailable Boolean @default(false)
  treatmentCenterType         String? // "PRIMARY", "DISTRICT", "SPECIALIZED", "REFERRAL"

  // Antivenom Status
  antivenomStatus         AntivenomStatus @default(UNKNOWN)
  antivenomStockQuantity  Int? // Stock level (null = not tracked)
  antivenomLastVerifiedAt DateTime?
  antivenomVerifiedBy     String? // User ID who verified
  antivenomStockPublic    Boolean         @default(false) // Whether to show stock quantity

  // Additional Medical Capabilities
  ventilatorAvailable Boolean @default(false)
  icuAvailable        Boolean @default(false)
  ambulanceAvailable  Boolean @default(false)
  bloodBankAvailable  Boolean @default(false)

  // Data Source & Verification
  source                  String? // "EDCD", "Provincial_Health", "Hospital_Direct", "Manual"
  sourceYear              String? // e.g., "2078/79", "2024"
  sourceUrl               String?
  verificationStatus      VerificationStatus @default(UNVERIFIED)
  officialTreatmentCenter Boolean            @default(false)

  // Status
  status HospitalStatus @default(ACTIVE)

  // Additional Information
  hospitalType    String? // "GOVERNMENT", "PRIVATE", "ARMY", "POLICE", "NGO"
  bedCapacity     Int?
  specializations String[]

  // Geospatial Intelligence Enhancements
  edcdCertified           Boolean              @default(false) // EDCD certified treatment center
  edcdCertificationDate   DateTime?
  treatmentCenterCategory TreatmentCenterType?
  populationCoverage      Int? // Estimated population served
  travelTimeCoverage      Json? // Isochrone data (travel time polygons)
  lastOperationalCheck    DateTime?

  // Metadata
  notes         String? @db.Text
  internalNotes String? @db.Text // Admin-only notes

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  // Relations
  verificationRecords HospitalVerification[]
  reports             HospitalReport[]
  sources             TreatmentCenterSource[] @relation("TreatmentCenterSources")
  historicalCases     SnakebiteCase[]         @relation("HistoricalCases")
  nearestTo           RescueRequest[]         @relation("NearestHospital")
  rescueVisits        RescueRequest[]         @relation("RescueHospitalVisits")

  @@index([latitude, longitude])
  @@index([snakebiteTreatmentAvailable])
  @@index([antivenomStatus])
  @@index([antivenomLastVerifiedAt])
  @@index([municipality])
  @@index([district])
  @@index([province])
  @@index([status])
  @@index([verificationStatus])
  @@map("hospitals")
}

enum AntivenomStatus {
  AVAILABLE // Verified in stock
  LOW_STOCK // Low but available
  OUT_OF_STOCK // Verified out of stock
  UNKNOWN // Not verified / no data
  NOT_SUPPORTED // Hospital doesn't provide antivenom
}

enum VerificationStatus {
  VERIFIED // Recently verified
  HISTORICAL // Based on old data (needs re-verification)
  STALE // Verification expired
  UNVERIFIED // No verification yet
}

enum HospitalStatus {
  ACTIVE
  INACTIVE
  TEMPORARILY_CLOSED
  PERMANENTLY_CLOSED
}

model HospitalVerification {
  id String @id @default(uuid())

  hospitalId String
  hospital   Hospital @relation(fields: [hospitalId], references: [id], onDelete: Cascade)

  // Verification Details
  verifiedBy       String // User ID
  verificationType String // "PHONE_CALL", "SITE_VISIT", "OFFICIAL_DOCUMENT", "HOSPITAL_REPORT"

  // What was verified
  snakebiteTreatment Boolean?
  antivenomStatus    AntivenomStatus?
  antivenomQuantity  Int?
  emergencyStatus    Boolean?
  ventilatorStatus   Boolean?

  // Verification Evidence
  notes               String?  @db.Text
  evidenceUrls        String[] // Photos, documents
  officialDocumentUrl String?

  // Source Information
  contactPerson      String? // Who provided the information
  contactDesignation String?
  contactPhone       String?

  verificationDate    DateTime  @default(now())
  nextVerificationDue DateTime?

  createdAt DateTime @default(now())

  @@index([hospitalId])
  @@index([verificationDate])
  @@map("hospital_verifications")
}

model HospitalReport {
  id String @id @default(uuid())

  hospitalId String
  hospital   Hospital @relation(fields: [hospitalId], references: [id], onDelete: Cascade)

  // Reporter Information
  reportedBy    String? // User ID (if logged in)
  reporterName  String?
  reporterEmail String?
  reporterPhone String?

  // Report Details
  reportType  String // "INCORRECT_INFO", "OUTDATED_STATUS", "CLOSED", "WRONG_LOCATION", "OTHER"
  description String @db.Text

  // Status
  status String @default("NEW") // NEW, UNDER_REVIEW, RESOLVED, DISMISSED

  // Resolution
  resolvedBy String?
  resolvedAt DateTime?
  resolution String?   @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([hospitalId])
  @@index([status])
  @@index([createdAt])
  @@map("hospital_reports")
}

// ===================================================================
// SYSTEM CONFIGURATION
// ===================================================================

model SystemSetting {
  id String @id @default(uuid())

  key      String @unique
  value    String @db.Text
  type     String @default("STRING") // STRING, NUMBER, BOOLEAN, JSON
  category String @default("GENERAL")

  description String?
  isPublic    Boolean @default(false)

  updatedBy String?
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())

  @@index([category])
  @@map("system_settings")
}

// ===================================================================
// GEOSPATIAL INTELLIGENCE MODELS
// ===================================================================
// Research-based snakebite hotspots, historical cases, treatment
// center provenance tracking, vehicle tracking, and analytics
// ===================================================================

model SnakebiteHotspot {
  id String @id @default(uuid())

  // Identity
  name        String  @unique
  description String?

  // Geometry (GeoJSON string until PostGIS is configured)
  geometryJson String? // GeoJSON polygon

  // Location
  district     String?
  municipality String?
  ward         Int?
  province     String?

  // Risk Metrics
  riskScore        Float // 0.0 - 1.0
  riskLevel        RiskLevel
  caseCount        Int?
  populationAtRisk Int?
  incidenceRate    Float? // per 100,000 population
  mortalityRate    Float? // percentage
  seasonalityScore Float? // 0.0 - 1.0 (1.0 = highly seasonal)

  // Source Metadata (Research provenance)
  source      String // e.g., "Sharma et al. 2021 - Nature Scientific Reports"
  sourceUrl   String?
  studyYear   Int?
  methodology String? // How the risk was determined
  confidence  Float? // 0.0 - 1.0

  // Temporal
  season         Season?
  monthlyPattern Json? // Array of monthly scores [0-11]

  // Status
  active Boolean @default(true)

  // Metadata
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  createdBy  String? // User ID who created this
  verifiedBy String? // Admin who verified this

  @@index([riskLevel, district])
  @@index([province, riskLevel])
  @@index([district, riskLevel])
  @@index([active])
  @@map("snakebite_hotspots")
}

model SnakebiteCase {
  id String @id @default(uuid())

  // Temporal
  year   Int
  month  Int? // 1-12
  season Season?
  date   DateTime? // If precise date known

  // Location (anonymized/aggregated for privacy)
  province     String?
  district     String?
  municipality String?
  ward         Int?
  latitude     Float?
  longitude    Float?

  // Patient Demographics (anonymized)
  ageGroup String? // "0-10", "11-20", "21-30", etc.
  sex      String? // "M", "F", "O", "UNKNOWN"

  // Snake Details
  speciesId     String?
  species       SnakeSpecies? @relation(fields: [speciesId], references: [id])
  speciesCommon String? // Common name if species not in database

  // Clinical
  envenomation Boolean? // Was there envenomation?
  symptoms     Json? // Array of symptoms
  outcome      CaseOutcome

  // Treatment
  treatmentCenterId     String?
  treatmentCenter       Hospital? @relation("HistoricalCases", fields: [treatmentCenterId], references: [id])
  treatmentDelayMinutes Int? // Time from bite to treatment
  antivenomGiven        Boolean?
  hospitalStayDays      Int?

  // Source Metadata
  source    String // "Research Paper", "Hospital Records", "Survey", "EDCD"
  sourceUrl String?
  studyId   String? // Reference to parent study
  caseId    String? // Original case ID in source

  // Data Quality
  dataQuality String? // "HIGH", "MEDIUM", "LOW"
  notes       String? // Additional context

  // Metadata
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  importedBy String? // User who imported this data

  @@index([year, district])
  @@index([province, year])
  @@index([outcome, year])
  @@index([district, year, month])
  @@index([season, year])
  @@map("snakebite_cases")
}

model TreatmentCenterSource {
  id String @id @default(uuid())

  treatmentCenterId String
  treatmentCenter   Hospital @relation("TreatmentCenterSources", fields: [treatmentCenterId], references: [id], onDelete: Cascade)

  // Source Details
  sourceType SourceType
  sourceUrl  String?
  sourceName String? // Name of the document/organization

  // Verification
  verifiedAt DateTime
  verifiedBy String? // User ID who verified

  // Additional Info
  notes           String?
  documentUrl     String? // Link to source document
  contactPerson   String? // Contact at source organization
  contactPhone    String?
  lastContactedAt DateTime?

  // Metadata
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([treatmentCenterId])
  @@index([sourceType])
  @@map("treatment_center_sources")
}

model RescueVehicle {
  id String @id @default(uuid())

  // Organization
  organizationId   String?
  organizationName String? // Name of org if not in system

  // Vehicle Details
  vehicleNumber String // Registration/identification number
  vehicleType   VehicleType
  model         String?
  year          Int?
  color         String?

  // Equipment
  equipment Json? // Array of equipment available

  // Status
  status VehicleStatus @default(AVAILABLE)

  // Location (persistent snapshot, not real-time)
  lastKnownLatitude  Float?
  lastKnownLongitude Float?
  lastLocationUpdate DateTime?

  // Capacity
  passengerCapacity Int?
  cargoCapacity     String?

  // Maintenance
  lastMaintenanceDate DateTime?
  nextMaintenanceDate DateTime?

  // Relations
  rescuers       Volunteer[]     @relation("VehicleRescuers")
  rescueRequests RescueRequest[] @relation("VehicleRescues")

  // Metadata
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  active    Boolean   @default(true)
  deletedAt DateTime? // Soft delete

  @@index([status, active])
  @@index([vehicleType])
  @@map("rescue_vehicles")
}

model SpeciesObservation {
  id String @id @default(uuid())

  // Observer
  observerId String?
  observer   User?   @relation(fields: [observerId], references: [id])

  // Species
  speciesId String?
  species   SnakeSpecies? @relation(fields: [speciesId], references: [id])

  // Location
  latitude     Float
  longitude    Float
  locationName String?
  district     String?
  municipality String?
  province     String?

  // Observation Details
  observedAt  DateTime
  behavior    String? // "basking", "hunting", "defensive", etc.
  habitat     String? // "forest", "grassland", "urban", etc.
  photoUrl    String?
  description String?

  // Validation
  validated   Boolean   @default(false)
  validatedBy String?
  validatedAt DateTime?

  // Metadata
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([speciesId, observedAt])
  @@index([district, province])
  @@map("species_observations")
}

model DistrictStatistics {
  id String @id @default(uuid())

  // Location
  district String @unique
  province String

  // Computed Metrics
  totalIncidents            Int        @default(0)
  activeRescues             Int        @default(0)
  completedRescues          Int        @default(0)
  snakebiteCases            Int        @default(0)
  deaths                    Int        @default(0)
  treatmentCenters          Int        @default(0)
  availableRescuers         Int        @default(0)
  avgResponseTimeMinutes    Float?
  medianResponseTimeMinutes Float?
  avgTravelDistanceKm       Float?
  successRate               Float?
  riskLevel                 RiskLevel?

  // Temporal
  lastIncidentDate  DateTime?
  lastSnakebiteDate DateTime?

  // Seasonality
  monsoonIncidents Int?
  winterIncidents  Int?
  springIncidents  Int?
  autumnIncidents  Int?

  // Top Species
  topSpecies Json? // Array of {speciesId, count}

  // Cache metadata
  lastCalculated DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([province])
  @@index([riskLevel])
  @@map("district_statistics")
}

// ===================================================================
// GEOSPATIAL ENUMS
// ===================================================================

enum RiskLevel {
  LOW
  MODERATE
  HIGH
  VERY_HIGH
  EXTREME
}

enum Season {
  WINTER // Dec-Feb
  SPRING // Mar-May
  MONSOON // Jun-Sep (HIGH RISK - 73.2% of cases)
  AUTUMN // Oct-Nov
}

enum CaseOutcome {
  RECOVERED // Full recovery
  RECOVERED_WITH_COMPLICATIONS // Survived with long-term effects
  DECEASED // Death
  LOST_TO_FOLLOWUP // Unknown outcome
  UNKNOWN
}

enum SourceType {
  EDCD // Epidemiology and Disease Control Division
  PROVINCIAL_HEALTH_AUTHORITY
  DISTRICT_HEALTH_OFFICE
  HOSPITAL_SELF_REPORTED
  RESEARCH_PAPER
  FIELD_SURVEY
  MANUAL_VERIFICATION
  SNAKESOS_COMMUNITY
  GOVERNMENT_DOCUMENT
  OTHER
}

enum VehicleType {
  RESCUE_VAN
  AMBULANCE
  MOTORBIKE
  BICYCLE
  CAR
  TRUCK
  OTHER
}

enum VehicleStatus {
  AVAILABLE
  ASSIGNED
