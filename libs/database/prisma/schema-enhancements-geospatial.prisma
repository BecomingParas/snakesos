// ===================================================================
// ANALYTICS MODELS (Computed/Cached)
// ===================================================================

model DistrictStatistics {
  id String @id @default(uuid())

  // Location
  district String @unique
  province String

  // Computed Metrics
  totalIncidents          Int      @default(0)
  activeRescues           Int      @default(0)
  completedRescues        Int      @default(0)
  snakebiteCases          Int      @default(0)
  deaths                  Int      @default(0)
  treatmentCenters        Int      @default(0)
  availableRescuers       Int      @default(0)
  avgResponseTimeMinutes  Float?
  medianResponseTimeMinutes Float?
  avgTravelDistanceKm     Float?
  successRate             Float?
  riskLevel               RiskLevel?

  // Temporal
  lastIncidentDate  DateTime?
  lastSnakebiteDate DateTime?

  // Seasonality
  monsoonIncidents   Int?
  winterIncidents    Int?
  springIncidents    Int?
  autumnIncidents    Int?

  // Top Species
  topSpecies Json? // Array of {speciesId, count}

  // Cache metadata
  lastCalculated DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([province])
  @@index([riskLevel])
  @@map("district_statistics")
}

