# ===================================================================
# OPENROUTER API
# ===================================================================
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Recommended free model with 1M context
OPENROUTER_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free

# Alternative models (uncomment to use)
# OPENROUTER_MODEL=nvidia/nemotron-3.5-lightning:free
# OPENROUTER_MODEL=nvidia/nemotron-3-super-120b-a12b:free

# ===================================================================
# EMAIL SERVICE (BREVO/SENDINBLUE SMTP)
# ===================================================================
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=9d5ead001@smtp-brevo.com
SMTP_PASSWORD=your_brevo_smtp_key_here
SMTP_FROM_EMAIL=noreply@snakesos.org
SMTP_FROM_NAME=SnakeSOS Platform

# ===================================================================
# STRIPE PAYMENT GATEWAY (DEVELOPMENT/TESTING ONLY)
# ===================================================================
# Get your test keys from: https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=sk_test_your_stripe_test_secret_key_here
STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_test_publishable_key_here
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret_here

# Enable Stripe development testing (set to 'true' for testing)
STRIPE_DEV_TESTING=true

# IMPORTANT: 
# - NEVER commit real Stripe keys to version control
# - Always use TEST MODE keys (sk_test_... and pk_test_...)
# - NEVER expose STRIPE_SECRET_KEY to the frontend

# ===================================================================
# APPLICATION
# ===================================================================
APP_NAME=SnakeSOS
APP_URL=http://localhost:3000
SUPPORT_EMAIL=support@snakesos.org

# Frontend URL (for Next.js)
NEXT_PUBLIC_APP_URL=http://localhost:4200
