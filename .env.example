# ===================================================================
# OPENROUTER API
# ===================================================================
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Recommended free model with 1M context
OPENROUTER_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free

# Alternative models (uncomment to use)
# OPENROUTER_MODEL=nvidia/nemotron-3.5-lightning:free
# OPENROUTER_MODEL=nvidia/nemotron-3-super-120b-a12b:free

# ===================================================================
# EMAIL SERVICE (BREVO/SENDINBLUE SMTP)
# ===================================================================
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=9d5ead001@smtp-brevo.com
SMTP_PASSWORD=your_brevo_smtp_key_here
SMTP_FROM_EMAIL=noreply@snakesos.org
SMTP_FROM_NAME=SnakeSOS Platform

# ===================================================================
# STRIPE PAYMENT GATEWAY (DEVELOPMENT/TESTING ONLY)
# ===================================================================
# Get your test keys from: https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=sk_test_your_stripe_test_secret_key_here
STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_test_publishable_key_here
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret_here

# Enable Stripe development testing (set to 'true' for testing)
STRIPE_DEV_TESTING=true
PAYMENT_ACTIVE_PROVIDER=STRIPE
STRIPE_SUCCESS_URL=http://localhost:4200/payment/success
STRIPE_CANCEL_URL=http://localhost:4200/payment/cancelled

# Nepal payment providers (set the credentials for the providers you enable)
ESEWA_PRODUCT_CODE=EPAYTEST
ESEWA_SECRET_KEY=your_esewa_secret_key_here
ESEWA_SUCCESS_URL=http://localhost:4200/payment/success
ESEWA_FAILURE_URL=http://localhost:4200/payment/cancelled
KHALTI_SECRET_KEY=your_khalti_secret_key_here
KHALTI_RETURN_URL=http://localhost:4200/payment/success
KHALTI_WEBSITE_URL=http://localhost:4200

# IMPORTANT: 
# - NEVER commit real Stripe keys to version control
# - Always use TEST MODE keys (sk_test_... and pk_test_...)
# - NEVER expose STRIPE_SECRET_KEY to the frontend

# ===================================================================
# APPLICATION
# ===================================================================
APP_NAME=SnakeSOS
APP_URL=http://localhost:3000
SUPPORT_EMAIL=support@snakesos.org

# Frontend URL (for Next.js)
NEXT_PUBLIC_APP_URL=http://localhost:4200

# ===================================================================
# NEPAL PAYMENT PROVIDERS (CODE-ONLY / FUTURE)
# ===================================================================
# These adapters are not registered by the development server. Configure
# them only when eSewa/Khalti credentials and a verified callback workflow
# are available.
ESEWA_PRODUCT_CODE=EPAYTEST
ESEWA_SECRET_KEY=your_esewa_sandbox_secret
ESEWA_SUCCESS_URL=https://YOUR-TUNNEL.example.com/api/payments/webhooks/ESEWA
ESEWA_FAILURE_URL=https://YOUR-TUNNEL.example.com/api/payments/webhooks/ESEWA
ESEWA_CHECKOUT_URL=https://rc-epay.esewa.com.np/api/epay/main/v2/form
ESEWA_STATUS_URL=https://rc-epay.esewa.com.np/api/epay/transaction/status/

KHALTI_SECRET_KEY=your_khalti_test_secret
KHALTI_RETURN_URL=https://YOUR-TUNNEL.example.com/api/payments/webhooks/KHALTI
KHALTI_WEBSITE_URL=https://YOUR-TUNNEL.example.com
KHALTI_INITIATE_URL=https://a.khalti.com/api/v2/epayment/initiate/
KHALTI_LOOKUP_URL=https://a.khalti.com/api/v2/epayment/lookup/

# ===================================================================
# GOOGLE MAPS API (FOR MAP FEATURES)
# ===================================================================
# Get your API key from: https://console.cloud.google.com/google/maps-apis
# Required APIs: Maps JavaScript API, Directions API, Places API
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# IMPORTANT: 
# - Add API key restrictions in Google Cloud Console
# - Restrict by HTTP referrer for frontend use
# - Set usage limits to prevent unexpected charges
