**/*.test.ts
**/*.test.tsx
**/*.spec.ts
**/*.spec.tsx
cypress/
apps/backend-e2e/

# Environment files (set in Vercel dashboard instead)
.env.local
.env.*.local

# Logs
*.log
logs/

# Temporary files
tmp/
*.tmp
.DS_Store
Thumbs.db

