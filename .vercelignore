# Vercel Ignore File
# Files/folders that Vercel should ignore during deployment
# This speeds up uploads and reduces deployment size

# Backend (not needed for frontend deployment)
apps/backend/
libs/backend/
libs/database/prisma/migrations/

# Documentation
docs/
*.md
!README.md

# Development files
.github/
.husky/
.vscode/
.claude/
.windsurf/
.kiro/

# Test files
**/*.test.ts
**/*.test.tsx
**/*.spec.ts
**/*.spec.tsx
cypress/
apps/backend-e2e/

# Build artifacts
dist/
.next/
.nx/
node_modules/.cache/

# Environment files (set in Vercel dashboard instead)
.env
.env.local
.env.*.local

# Logs
*.log
logs/

# Temporary files
tmp/
*.tmp
.DS_Store
Thumbs.db

# Scripts (build scripts are run by Vercel)
scripts/
run-seed.mjs
test-password.js

# Configuration files not needed for deployment
.prettierrc
.prettierignore
.nxignore
.gitattributes
jest.config.ts
jest.preset.js
cypress.config.ts

# Lock files (npm install uses package-lock.json automatically)
yarn.lock
pnpm-lock.yaml

# Session summaries and documentation
SESSION_*.md
*_SUMMARY.md
*_STATUS.md
*_GUIDE.md
IMPLEMENTATION_*.md
RESEED_INSTRUCTIONS.md
QUICK_*.md
START_HERE.md
